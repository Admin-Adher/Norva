# Norva - Environment variables
# Copy to .env and fill in your values

# Server
PORT=3000
JWT_SECRET=change-this-to-a-random-secret-in-production

# Supabase (optional - enables cloud device registry, remote pairing, watch history sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Norva Cloud API / Playback
NORVA_CLOUD_API_URL=https://your-project.supabase.co/functions/v1/norva-cloud
ALLOWED_ORIGINS=https://norva-web.example,https://norva-pwa.example
RELAY_TOKEN_SECRET=change-this-to-a-long-random-secret
NORVA_RELAY_BASE_URL=https://relay.norva.example
NORVA_MEDIA_GATEWAY_URL=https://media-gateway.norva.example
NORVA_MEDIA_GATEWAY_TOKEN=change-this-to-a-long-random-secret
# Optional exact-account playback canary. Leave all four values empty to keep
# every account on NORVA_MEDIA_GATEWAY_URL. USER_HASHES contains comma-separated
# lowercase SHA-256 digests of authenticated user UUIDs, never emails.
NORVA_MEDIA_GATEWAY_CANARY_URL=
NORVA_MEDIA_GATEWAY_CANARY_TOKEN=
NORVA_MEDIA_GATEWAY_CANARY_ID=
NORVA_MEDIA_GATEWAY_CANARY_USER_HASHES=

# Norva Relay
PUBLIC_BASE_URL=https://relay.norva.example

# Norva Media Gateway
GATEWAY_TOKEN=change-this-to-a-long-random-secret
OUTPUT_DIR=/tmp/norva-media-gateway
FFMPEG_PATH=ffmpeg
# Video transcode backend. `software` preserves the existing libx264 graph.
# `vaapi` is an explicit single-backend choice: startup performs a one-frame
# H.264 hardware preflight and fails closed if the render node/driver is absent.
MEDIA_GATEWAY_VIDEO_ENCODER=software
MEDIA_GATEWAY_VAAPI_DEVICE=/dev/dri/renderD128
MEDIA_GATEWAY_VAAPI_DECODE=false
# Hard lifetime cap for video-encoding children. Copy/remux/cache hits do not
# consume a slot. Start the shared Hetzner host conservatively at 4.
MAX_ACTIVE_VIDEO_ENCODER_SESSIONS=16
# Dedicated 32-byte key (64 lowercase hex characters) used to attest a full
# MKV H.264 file after exact EOF analysis. Do not reuse GATEWAY_TOKEN.
MKV_H264_FAST_START_PROOF_HMAC_KEY=

# Complete HLS cache. It is fail-closed and off by default. The current
# implementation is safe only for one Gateway process with private local
# storage; multi-replica/shared-volume coordination is intentionally rejected.
MKV_COMPLETE_HLS_CACHE_ENABLED=false
MKV_CACHE_COORDINATION_MODE=local
MKV_CACHE_SINGLE_INSTANCE_ATTESTED=false
MKV_COMPLETE_HLS_CACHE_ROOT=/tmp/norva-media-gateway-cache
# Dedicated 32-byte key (64 lowercase hex characters); never reuse the proof
# key or GATEWAY_TOKEN.
MKV_COMPLETE_HLS_CACHE_MANIFEST_HMAC_KEY=
MKV_COMPLETE_HLS_CACHE_TTL_MS=604800000
MKV_COMPLETE_HLS_CACHE_MAX_BYTES=68719476736
MKV_COMPLETE_HLS_CACHE_MIN_FREE_BYTES=2147483648
MKV_COMPLETE_HLS_CACHE_MAX_ENTRY_BYTES=34359738368
MKV_COMPLETE_HLS_CACHE_MAX_FILES=20000
MKV_COMPLETE_HLS_CACHE_MAX_PLAYLIST_BYTES=8388608
MKV_COMPLETE_HLS_CACHE_PRUNE_INTERVAL_MS=900000
# Optional same-process continuation after a normal viewer close. The browser
# is revoked immediately; the existing provider pump and FFmpeg may run only
# until EOF or the bounded deadline, and a new viewer preempts them first.
MKV_COMPLETE_HLS_BACKGROUND_CONTINUATION_ENABLED=false
MKV_COMPLETE_HLS_BACKGROUND_CONTINUATION_MAX_MS=1800000
MKV_COMPLETE_HLS_BACKGROUND_CALLBACK_TIMEOUT_MS=10000

# Admin-only MKV Strategy Lab. Keep disabled until the private runner, fixed
# fixture corpus, and dedicated physical Gateway/browser adapter are present.
# The Edge and runner tokens must match; the actor key is a separate 32-byte
# lowercase-hex HMAC key and never crosses into the browser.
NORVA_MEDIA_LAB_ENABLED=false
NORVA_MEDIA_LAB_RUNNER_URL=
NORVA_MEDIA_LAB_RUNNER_TOKEN=
NORVA_MEDIA_LAB_ACTOR_HMAC_KEY=
MEDIA_LAB_RUNNER_TOKEN=
MEDIA_LAB_FIXTURE_ROOT=/srv/norva-media-lab/fixtures/generated
MEDIA_LAB_BIND_HOST=127.0.0.1
MEDIA_LAB_ALLOW_REMOTE_BIND=false
MEDIA_LAB_PROVIDER_ORIGIN=
MEDIA_LAB_RUN_TIMEOUT_MS=600000
# Optional private executor that owns the dedicated Lab Gateway and Chromium.
# Without both values the runner stays installed but returns an explicit
# blocked result; it never fabricates a passing media measurement.
MEDIA_LAB_PHYSICAL_ADAPTER_URL=
MEDIA_LAB_PHYSICAL_ADAPTER_TOKEN=
# Preferred co-located executor: the runner talks directly to a dedicated Lab
# Gateway and launches its own Chromium. Do not set these together with the
# remote adapter pair above.
MEDIA_LAB_GATEWAY_URL=
MEDIA_LAB_GATEWAY_TOKEN=
MEDIA_LAB_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
MEDIA_LAB_HLS_JS_PATH=/app/vendor/hls.min.js
MEDIA_LAB_GATEWAY_SESSION_TIMEOUT_MS=180000
MEDIA_LAB_BROWSER_TIMEOUT_MS=60000
# Edge base URL for the account-activity reporter (keeps the provider single-connection
# busy-lock accurate for live-web / long native playback that the edge session/event/
# history writers don't cover). Point at the norva-playback function, e.g.
# https://<supabase-ref>.supabase.co/functions/v1/norva-playback. Leave empty to keep
# the reporter idle (busy-lock still works via the edge-side writers; no regression).
NORVA_EDGE_CALLBACK_BASE=

# Hub identity (auto-detected if not set)
HUB_NAME=Norva Hub
HUB_PUBLIC_URL= # Set if using Cloudflare Tunnel or reverse proxy, e.g. https://xxxx.trycloudflare.com

# Web app CORS (comma-separated origins, e.g. https://norva.tv)
CORS_ORIGINS=

# OIDC SSO (optional)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=

# TMDB (optional - for movie/series metadata)
TMDB_API_KEY=
