# Copy to .env.media-lab on the server. Never commit populated values.
MEDIA_LAB_UID=1000
MEDIA_LAB_GID=1000
RENDER_GID=REPLACE_FROM_GETENT_GROUP_RENDER
NORVA_DOCKER_NETWORK=norva_default

# Both images must be locally built and pinned to validated immutable revisions.
MEDIA_LAB_GATEWAY_IMAGE=norva-media-gateway:vaapi-REPLACE_WITH_V105_REVISION
MEDIA_LAB_RUNNER_IMAGE=norva-media-lab-runner:REPLACE_WITH_VALIDATED_REVISION
MEDIA_LAB_RUNNER_SOURCE_SHA=REPLACE_WITH_64_LOWERCASE_HEX

# Separate resource envelope from user playback. The runner is globally mono-slot.
MEDIA_LAB_GATEWAY_CPUS=4.0
MEDIA_LAB_GATEWAY_MEMORY_LIMIT=6g
MEDIA_LAB_GATEWAY_MEMORY_RESERVATION=1g
MEDIA_LAB_RUNNER_CPUS=2.0
MEDIA_LAB_RUNNER_MEMORY_LIMIT=3g
MEDIA_LAB_RUNNER_MEMORY_RESERVATION=512m
MEDIA_LAB_GATEWAY_OUTPUT_DIR=/srv/norva-media-lab/output
MEDIA_LAB_GATEWAY_CACHE_DIR=/srv/norva-media-lab/cache

# Generate each value independently. The runner token is also copied into the
# self-hosted Supabase .env as NORVA_MEDIA_LAB_RUNNER_TOKEN. The actor HMAC key
# is Edge-only and therefore is not present in this file.
MEDIA_LAB_RUNNER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_NONSPACE_CHARACTERS
MEDIA_LAB_GATEWAY_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
MEDIA_LAB_FAST_START_HMAC_KEY=REPLACE_WITH_64_LOWERCASE_HEX
MEDIA_LAB_CACHE_HMAC_KEY=REPLACE_WITH_DIFFERENT_64_LOWERCASE_HEX

# Short-lived, bounded cache used only by the fixed HEVC cache fixture.
MEDIA_LAB_CACHE_TTL_MS=86400000
MEDIA_LAB_CACHE_MAX_BYTES=8589934592
MEDIA_LAB_CACHE_MIN_FREE_BYTES=171798691840
MEDIA_LAB_CACHE_MAX_ENTRY_BYTES=2147483648
MEDIA_LAB_CACHE_MAX_FILES=4000
MEDIA_LAB_CACHE_MAX_PLAYLIST_BYTES=1048576
MEDIA_LAB_CACHE_PRUNE_INTERVAL_MS=300000

MEDIA_LAB_RUN_TIMEOUT_MS=600000
MEDIA_LAB_GATEWAY_SESSION_TIMEOUT_MS=180000
MEDIA_LAB_BROWSER_TIMEOUT_MS=60000
