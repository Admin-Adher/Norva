# Copy to .env.media-vaapi on the server. Never commit the populated file.
MEDIA_GATEWAY_UID=1000
MEDIA_GATEWAY_GID=1000
RENDER_GID=REPLACE_FROM_GETENT_GROUP_RENDER
NORVA_DOCKER_NETWORK=norva_default
MEDIA_GATEWAY_HOST_PORT=8081
MEDIA_GATEWAY_IMAGE=norva-media-gateway:vaapi-REPLACE_WITH_VALIDATED_REVISION

# Hard resource envelope for the shared Supabase + media host.
MEDIA_GATEWAY_CPUS=6.0
MEDIA_GATEWAY_MEMORY_LIMIT=10g
MEDIA_GATEWAY_MEMORY_RESERVATION=2g
MAX_ACTIVE_VIDEO_ENCODER_SESSIONS=4
MEDIA_GATEWAY_OUTPUT_DIR=/srv/norva-media/output
MEDIA_GATEWAY_CACHE_DIR=/srv/norva-media/cache

# Browser-visible HTTPS media origin and authenticated Edge callback. The
# callback persists only a finalized, session-bound cache proof through CAS.
PUBLIC_BASE_URL=https://media.norva.tv
NORVA_EDGE_CALLBACK_BASE=https://api.norva.tv/functions/v1/norva-playback
NORVA_BACKEND_ORIGINS=https://api.norva.tv

# Must match the norva-playback Edge secret. Generate/store manually.
GATEWAY_TOKEN=REPLACE_WITH_EXISTING_GATEWAY_TOKEN

# Three distinct secrets. Each HMAC key is exactly 32 random bytes encoded as
# 64 lowercase hexadecimal characters. Never reuse GATEWAY_TOKEN or each other.
MKV_H264_FAST_START_PROOF_HMAC_KEY=REPLACE_WITH_64_LOWERCASE_HEX
MKV_H264_FAST_START_PROOF_HMAC_PREVIOUS_KEY=
MKV_COMPLETE_HLS_CACHE_MANIFEST_HMAC_KEY=REPLACE_WITH_DIFFERENT_64_LOWERCASE_HEX

# HTTP remains mandatory for FFmpeg/FFprobe. The optional SOCKS5 pool must contain
# the same slots in the same order and accelerates only Node fetch/undici traffic.
PROVIDER_PROXY_URLS=
PROVIDER_PROXY_SOCKS_URLS=
PROVIDER_PROXY_SLOT_OVERRIDES=

# Adaptive provider routing. Keep both switches false for the initial code-only
# rollout. The fingerprint key is an independent 32-byte lowercase-hex secret.
PROVIDER_ADAPTIVE_ROUTE_ENABLED=false
PROVIDER_ROUTE_FINGERPRINT_HMAC_KEY=
PROVIDER_ROUTE_BENCHMARK_ENABLED=false
PROVIDER_ADAPTIVE_ROUTE_LOOKUP_TIMEOUT_MS=500
PROVIDER_ROUTE_BENCHMARK_SETTLE_MS=5000
PROVIDER_ROUTE_BENCHMARK_RETRY_MS=30000
PROVIDER_ROUTE_BENCHMARK_COOLDOWN_MS=21600000
PROVIDER_ROUTE_BENCHMARK_MAX_PENDING=32

# 96 GiB cache, with a hard 160 GiB host-free-space floor.
MKV_COMPLETE_HLS_CACHE_TTL_MS=604800000
MKV_COMPLETE_HLS_CACHE_MAX_BYTES=103079215104
MKV_COMPLETE_HLS_CACHE_MIN_FREE_BYTES=171798691840
MKV_COMPLETE_HLS_CACHE_MAX_ENTRY_BYTES=25769803776
MKV_COMPLETE_HLS_CACHE_MAX_FILES=20000
MKV_COMPLETE_HLS_CACHE_MAX_PLAYLIST_BYTES=8388608
MKV_COMPLETE_HLS_CACHE_PRUNE_INTERVAL_MS=900000
# Keep normal player exits resource-clean. Dedicated cache-fill hosts may opt in.
MKV_COMPLETE_HLS_BACKGROUND_CONTINUATION_ENABLED=false
MKV_COMPLETE_HLS_BACKGROUND_CONTINUATION_MAX_MS=1800000
MKV_COMPLETE_HLS_BACKGROUND_CALLBACK_TIMEOUT_MS=10000

# Private shared HLS cache. Secrets may be staged while every feature switch
# remains false; activation then happens one explicit stage at a time.
NORVA_SHARED_MEDIA_CACHE_ENABLED=false
NORVA_MEDIA_CACHE_WORKER_URL=https://media-cache.norva.tv
NORVA_MEDIA_CACHE_WORKER_TOKEN=
NORVA_MEDIA_CACHE_MANIFEST_HMAC_KEY=
NORVA_SHARED_MEDIA_CACHE_TTL_MS=2592000000
NORVA_SHARED_MEDIA_CACHE_CALLBACK_TIMEOUT_MS=10000
NORVA_MEDIA_CACHE_PRODUCER_HEARTBEAT_MS=20000
MEDIA_CACHE_LIVE_JOIN_ENABLED=false
MEDIA_CACHE_LIVE_JOIN_MAX_VIEWERS=64
NORVA_SHARED_MEDIA_CACHE_BACKGROUND_CONTINUATION_ENABLED=false
