# Build-only artifact for the bounded strict-LID speech selector. This does not
# replace or start the production media gateway. The gateway already owns the
# separately hash-pinned Silero model; this artifact contains no model or access.
ARG WHISPER_CPP_COMMIT=080bbbe85230f624f0b52127f1ae1218247989f9

FROM debian:bookworm-slim AS build
ARG WHISPER_CPP_COMMIT
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/whisper.cpp
RUN test "${WHISPER_CPP_COMMIT}" = "080bbbe85230f624f0b52127f1ae1218247989f9" \
    && git init . \
    && git remote add origin https://github.com/ggml-org/whisper.cpp.git \
    && git fetch --depth 1 origin "${WHISPER_CPP_COMMIT}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${WHISPER_CPP_COMMIT}" \
    && cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_EXE_LINKER_FLAGS="-static -static-libgcc -static-libstdc++" \
        -DWHISPER_BUILD_TESTS=OFF \
        -DWHISPER_BUILD_EXAMPLES=ON \
        -DGGML_NATIVE=OFF \
        -DGGML_BACKEND_DL=OFF \
        -DGGML_OPENMP=OFF \
        -DGGML_BLAS=OFF \
        -DGGML_VULKAN=OFF \
        -DGGML_CUDA=OFF \
        -DGGML_METAL=OFF \
    && cmake --build build --parallel 2 --config Release --target whisper-vad-speech-segments \
    && ! readelf -l build/bin/whisper-vad-speech-segments | grep -q INTERP
RUN mkdir -p /artifact \
    && cp build/bin/whisper-vad-speech-segments /artifact/whisper-vad-speech-segments \
    && chmod 0755 /artifact/whisper-vad-speech-segments \
    && sha256sum /artifact/whisper-vad-speech-segments | cut -d' ' -f1 > /artifact/vad-bin.sha256 \
    && printf '%s\n' "${WHISPER_CPP_COMMIT}" > /artifact/vad-commit \
    && chmod 0644 /artifact/vad-bin.sha256 /artifact/vad-commit

# A subsequent reviewed gateway image can COPY these exact paths and verify the
# digest at startup. No startup command, GPU stack, credentials or network client
# is shipped in the artifact stage.
FROM scratch AS artifact
COPY --from=build /artifact/whisper-vad-speech-segments /usr/local/bin/whisper-vad-speech-segments
COPY --from=build /artifact/vad-bin.sha256 /opt/whisper/vad-bin.sha256
COPY --from=build /artifact/vad-commit /opt/whisper/vad-commit
