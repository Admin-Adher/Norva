# /etc/norva-gc.env — no credentials; root:root 644 is sufficient.
# Loaded only by norva-proof-gc.service and norva-docker-gc.service.

PROOF_GC_FAILED_TTL_HOURS=72
PROOF_GC_SUCCESS_TTL_HOURS=0
PROOF_GC_ROOT=/var/lib/norva-phase3-proof
PROOF_GC_HOME=/home/adrien/norva-phase3-proof
PROOF_GC_IMAGE=supabase/postgres:17.6.1.136

DOCKER_GC_MAX_CACHE_SPACE=12GB
DOCKER_GC_RESERVED_CACHE_SPACE=8GB
DOCKER_GC_MIN_FREE_SPACE=120GB
DOCKER_GC_IMAGE_MIN_AGE_HOURS=168
DOCKER_GC_ROLLBACK_IMAGES_PER_FAMILY=2
