# =============================================================================
# /etc/norva-backup.env — self-host backup settings (box-only, root:root 600)
#   sudo cp norva-backup.env.example /etc/norva-backup.env
#   sudo chmod 600 /etc/norva-backup.env && sudo nano /etc/norva-backup.env
# NEVER commit the filled file. The R2 credentials are the same kind used by the
# managed-DB GitHub workflow (an R2 API token with read/write on the bucket).
# =============================================================================

# --- Cloudflare R2 (S3 API) ---------------------------------------------------
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=norva-db-backups
# Key prefixes inside the bucket (self-host lives beside the managed 'db/' dumps)
R2_PREFIX_DUMPS=selfhost/dumps
R2_PREFIX_WAL=selfhost/wal
R2_PREFIX_BASE=selfhost/base

# --- Encryption of nightly logical dumps ------------------------------------
# Keep this true in production. BACKUP_AGE_RECIPIENT is the public age
# recipient only (age1...); the private identity must stay off the server.
BACKUP_ENCRYPTION_REQUIRED=true
BACKUP_AGE_RECIPIENT=age1CHANGE_ME

# --- Local paths / stack ------------------------------------------------------
# ops/hetzner checkout on the box (where .env with POSTGRES_PASSWORD lives)
NORVA_OPS_DIR=/home/adrien/norva/ops/hetzner
WAL_ARCHIVE_DIR=/var/lib/norva/wal-archive
BACKUP_STAGE_DIR=/var/lib/norva/backups
# Stream the physical base backup straight to R2 instead of staging a full copy
# in BACKUP_STAGE_DIR first. Staging needs ~2x the database size free, and that
# is what caps this box: ~20 M titles staged vs ~31 M streamed. The artifact is
# byte-identical (base.tar.gz, WAL folded in), so RESTORE.md is unchanged.
# Trade-off: a stream cannot be retried. A network blip loses the run and the
# next daily one recovers it. Flip to true ONLY after a restore drill has
# validated a streamed artifact (BACKUPS.md).
BASEBACKUP_STREAM=false
PG_IMAGE=supabase/postgres:17.6.1.136

# --- Retention ------------------------------------------------------------------
KEEP_DUMPS_DAYS=14        # nightly logical dumps on R2
KEEP_BASE_COUNT=3         # base backups on R2. The base timer is DAILY, so this is
                          # also the number of days of PITR anchors you keep.
KEEP_WAL_DAYS=3           # WAL on R2. MUST be >= KEEP_BASE_COUNT, otherwise the
                          # oldest base backup has no WAL chain and is unreplayable.
                          # Audit 2026-07-17 : 35 j de WAL brut (16 Mo/segment)
                          # faisaient ~80 % des 51 GB du bucket pour rien.
                          # Audit 2026-08-20 : a 27 GiB/jour de WAL, chaque jour
                          # de retention coute ~27 GiB. Voir checkpoint_timeout
                          # dans docker-compose.supabase.yml — c'est la cause
                          # amont (FPI a chaque checkpoint), pas la retention.
KEEP_LOCAL_WAL_MINUTES=60 # local WAL copies (already on R2) — local is just a cache,
                          # R2 keeps KEEP_WAL_DAYS for PITR. Keep this SMALL: during a
                          # high-churn phase (initial import/enrichment) a large value
                          # lets the local archive balloon (e.g. 3d x ~60GB/day = ~180GB).
WAL_R2_LOCK_FILE=/run/lock/norva-wal-r2.lock # serializes sync verification and R2 retention
WAL_R2_SYNC_LOCK_WAIT_SECONDS=30             # short sync retry; next timer runs in 5 min
WAL_R2_PRUNE_LOCK_WAIT_SECONDS=600           # daily prune may wait for the current sync

# --- Capacity watchdog (norva-capacity-check.timer, 06:40 UTC) -----------------
# Thresholds. Alerts go to the Telegram bot configured in the stack .env
# (TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID) and the unit exits non-zero.
CAPACITY_WAL_WARN_GIB=15   # WAL/day. ~6 GiB/day at 2026-08-21; 15 is ~2.5x.
                           # R2 storage = this rate x KEEP_WAL_DAYS, so the rate
                           # IS the cost. A jump means an upstream regression.
CAPACITY_TITLE_WARN_BYTES=12000 # marginal cost of one catalogue title across the
                           # per-user cloud_* tables. 10109 at 2026-08-27 after
                           # the Phase-3 schema and a measured REINDEX pass. This
                           # is a growth alarm; confirm actual index density with
                           # pgstatindex before rebuilding. Excludes catalog_*
                           # fixed overhead. Per-user figures are skewed by one
                           # 523k-title account.
CAPACITY_USER_WARN_MIB=1200 # cloud_* bytes per catalogue-bearing user. 848 MiB
                           # at 2026-08-21 after REINDEX. Drift up = index bloat
                           # returning (cloud_titles sits at ~14% HOT).
CAPACITY_DISK_WARN_PCT=70  # basebackup-weekly.sh stages a full physical copy
                           # locally, so it needs ~2x the database size free.
                           # That staging, not R2 cost, is what caps the box.

# --- Unit health + monthly reindex -------------------------------------------
# capacity-check.sh also asks systemd about the other backup units, because
# nothing else does: Netdata has no systemdunits collector here. Format is
# "unit:max_hours_since_last_successful_run". A unit that has never run is
# reported too - it looks healthier than a failed one and is just as bad.
CAPACITY_UNIT_CHECKS="norva-backup-nightly:36 norva-basebackup:36 norva-wal-prune-r2:36 norva-wal-sync:1"
# Tables reindexed monthly. cloud_titles runs at ~14% HOT, so index bloat is
# the steady state. catalog_titles is TOAST-dominated, so it is intentionally
# excluded: rebuilding its tiny index set does not reclaim the payload.
REINDEX_TABLES="public.cloud_titles public.cloud_media_items public.cloud_title_variants"
