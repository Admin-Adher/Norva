# PREPARATION ONLY. Not sourced automatically by deployment.
# Apply only after natural playback/worker drain, on both Gateway replicas.
# Keep the existing owner allowlist intact for rollback; no identities here.
PRIVATE_RESUME_CACHE_ENABLED=true
PRIVATE_RESUME_RECENT_SAMPLES_ENABLED=true
PRIVATE_RESUME_RECENT_SAMPLES_ALL_AUTHENTICATED_OWNERS=true
# Existing aggregate ceilings: do not multiply them by the number of owners.
PRIVATE_RESUME_HLS_CACHE_MAX_BYTES=268435456
PRIVATE_RESUME_HLS_CACHE_PER_FILE_BYTES=67108864
# Rollback to the existing pilot: set ALL_AUTHENTICATED_OWNERS=false.
# Emergency disable of sampled reuse only: set RECENT_SAMPLES_ENABLED=false.
# Retained media remains owner/source/revision/profile private in every mode.
