# Gateway: explicit general enrollment; keep pilot hashes for scope rollback.
PRIVATE_RESUME_CACHE_ENABLED=true
PRIVATE_RESUME_RECENT_SAMPLES_ENABLED=true
PRIVATE_RESUME_RECENT_SAMPLES_ALL_AUTHENTICATED_OWNERS=true
PRIVATE_RETAINED_SESSION_ENABLED=true
PRIVATE_RETAINED_SESSION_ALL_AUTHENTICATED_OWNERS=true
VOD_STARTUP_OBSERVATION_ENABLED=true
VOD_STARTUP_OBSERVATION_ALL_AUTHENTICATED_OWNERS=true
VOD_STARTUP_SMALL_WINDOWS_ENABLED=true
VOD_STARTUP_SMALL_WINDOWS_ALL_AUTHENTICATED_OWNERS=true

# Gateway AND both Edge replicas. Never infer general scope from an empty list.
PRIVATE_STARTUP_CACHE_ENABLED=true
PRIVATE_STARTUP_CACHE_ALL_AUTHENTICATED_OWNERS=true

# Existing aggregate budget per Gateway, independent of the number of owners.
PRIVATE_RESUME_HLS_CACHE_MAX_BYTES=268435456
PRIVATE_RESUME_HLS_CACHE_PER_FILE_BYTES=67108864

# This example is not loaded automatically. Foreground claims remain private,
# authenticated, source/revision/track exact and subject to fresh revalidation.
# Background prefix preparation remains the existing bounded operator queue;
# general eligibility does not enqueue or download every catalogue file.
# Rollback: restore the saved false global flags and pilot lists after drain.
