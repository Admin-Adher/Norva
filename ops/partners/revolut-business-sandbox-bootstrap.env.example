# Copy this template to an ACL-protected directory outside the repository.
# The short-lived authorization code must be stored in its own 0600/ACL-only
# file. Never paste the code, refresh token, or private key into a shell command.
REVOLUT_BUSINESS_ENVIRONMENT=sandbox
REVOLUT_BUSINESS_CLIENT_ID=
REVOLUT_BUSINESS_ISSUER=norva.tv
REVOLUT_BUSINESS_PRIVATE_KEY_FILE=C:/protected/path/privatecert.pem
REVOLUT_BUSINESS_AUTHORIZATION_CODE_FILE=C:/protected/path/authorization-code.txt
REVOLUT_BUSINESS_SANDBOX_TOKEN_FILE=C:/protected/path/sandbox-oauth-stage.env
REVOLUT_BUSINESS_SANDBOX_OUTPUT_FILE=C:/protected/path/sandbox-runtime.env
REVOLUT_BUSINESS_SOURCE_CURRENCY=GBP
REVOLUT_BUSINESS_SOURCE_ACCOUNT_ID=
REVOLUT_BUSINESS_TEST_USER_INDEX=1
REVOLUT_BUSINESS_BENEFICIARY_ACCOUNT_ID=
REVOLUT_BUSINESS_TOPUP_AMOUNT=100
REVOLUT_BUSINESS_SMOKE_AMOUNT_MINOR=100
REVOLUT_BUSINESS_MAX_FEE_MINOR=1000
REVOLUT_BUSINESS_TIMEOUT_MS=7000
