# Dedicated Revolut Business Sandbox smoke test only.
# Never source this file into the production Edge containers and never copy
# Merchant API credentials into these Business API variables.
NORVA_PARTNERS_REVOLUT_API_ENABLED=true
REVOLUT_BUSINESS_ENVIRONMENT=sandbox
REVOLUT_BUSINESS_SANDBOX_SKIP_TRANSFER_FIELDS=true
REVOLUT_BUSINESS_SANDBOX_SIMULATION_ACTION=complete
REVOLUT_BUSINESS_CLIENT_ID=
REVOLUT_BUSINESS_ISSUER=norva.tv
# The isolated runner refuses an inline private key. Keep the key in an
# ACL-protected file outside the repository.
REVOLUT_BUSINESS_PRIVATE_KEY_FILE=C:/protected/path/privatecert.pem
# The bootstrap writes these short-lived Sandbox values. Do not populate them
# manually and do not reuse them for production.
REVOLUT_BUSINESS_REFRESH_TOKEN=
REVOLUT_BUSINESS_ACCESS_TOKEN=
REVOLUT_BUSINESS_ACCESS_TOKEN_EXPIRES_AT=
REVOLUT_BUSINESS_SOURCE_ACCOUNTS_JSON=
REVOLUT_BUSINESS_MAX_FEE_MINOR_JSON=
REVOLUT_BUSINESS_TIMEOUT_MS=7000

# One fresh test transfer. Use only UUIDs issued by the separate Sandbox
# account. The runner prints hashes, never these identifiers.
NORVA_REVOLUT_SANDBOX_JOB_JSON=
